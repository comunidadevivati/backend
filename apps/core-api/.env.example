# Copie para .env.local (não versionado) para rodar a Core API local com `pnpm dev:api`.
PORT=3001

# PostgreSQL (schema organization). Senha local: POSTGRES_PASSWORD do .env da raiz.
# A Core API aplica as migrations pendentes ao iniciar: só aponte para o banco de HML em branches
# sem migrations novas.
DATABASE_URL=postgresql://comunidade_viva:substituir_por_senha@localhost:5432/comunidade_viva

# Credencial de serviço compartilhada com o BFF (mínimo de 32 caracteres). Use o mesmo valor em
# CORE_API_TOKEN do apps/bff/.env.local. Gere com: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
CORE_API_TOKEN=

# Galeria de fotos (ADR 0010). "disabled" desliga os envios; "s3" usa o emulador local do compose
# (docker compose up -d media) ou o Cloudflare R2 em HML/produção.
MEDIA_STORAGE=s3
MEDIA_S3_ENDPOINT=http://localhost:9000
MEDIA_S3_REGION=us-east-1
# Credenciais padrão do serviço "media" do compose (somente desenvolvimento local).
MEDIA_S3_ACCESS_KEY_ID=viva-dev-access
MEDIA_S3_SECRET_ACCESS_KEY=viva-dev-secret-key
# Bucket único; cada ambiente usa sua pasta (dev, hml, prod).
MEDIA_BUCKET=comunidade-viva-media
MEDIA_KEY_PREFIX=dev
