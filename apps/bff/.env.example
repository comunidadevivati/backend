# Copie para .env.local (não versionado) para rodar o BFF local com `pnpm dev:bff`.
# BFF
BFF_PORT=3000
BFF_BASE_URL=http://localhost:3000

# Frontend React (Vite)
WEB_BASE_URL=http://localhost:5173

# Segredo local para assinatura dos cookies (mínimo de 32 caracteres)
COOKIE_SECRET=

# PostgreSQL (usuários e sessões no schema auth). Senha local: POSTGRES_PASSWORD do .env da raiz.
# O BFF aplica as migrations pendentes ao iniciar: só aponte para o banco de HML em branches sem
# migrations novas.
DATABASE_URL=postgresql://comunidade_viva:substituir_por_senha@localhost:5432/comunidade_viva

# E-mail transacional. Use disabled para não enviar; resend exige RESEND_API_KEY (chave de HML).
EMAIL_PROVIDER=disabled
RESEND_API_KEY=
EMAIL_FROM=Comunidade Viva e Eficaz (HML) <seguranca@mail.comvivaeficaz.com.br>
PASSWORD_RESET_TTL_MINUTES=15
PASSWORD_RESET_COOLDOWN_SECONDS=60
EMAIL_SEND_TIMEOUT_MS=5000
EMAIL_VERIFICATION_TTL_HOURS=24
EMAIL_VERIFICATION_COOLDOWN_SECONDS=60
