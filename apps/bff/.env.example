# Keycloak / OpenID Connect
KEYCLOAK_ISSUER=http://localhost:8080/realms/comunidade-viva
KEYCLOAK_CLIENT_ID=comvivati-bff
# KEYCLOAK_CLIENT_SECRET: configurar exclusivamente no .env.local

# BFF
BFF_PORT=3000
BFF_BASE_URL=http://localhost:3000
BFF_OIDC_CALLBACK_URL=http://localhost:3000/auth/callback

# Frontend React
WEB_BASE_URL=http://localhost:5173

# Segredo local para assinatura dos cookies
COOKIE_SECRET=

REDIS_URL=redis://127.0.0.1:6379

SESSION_ENCRYPTION_KEY=
