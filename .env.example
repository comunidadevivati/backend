# Copie para .env (não versionado). Usado somente pelo compose.yaml (PostgreSQL local).
# Use apenas [A-Za-z0-9._~-]: a senha também entra na DATABASE_URL do BFF.
POSTGRES_PASSWORD=substituir_por_senha_segura

# Somente para o perfil app do compose.yaml: credencial de serviço BFF -> Core API (mínimo de 32
# caracteres). Gere com: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
CORE_API_TOKEN=
